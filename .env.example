# Public backend origin (no secrets). /api/v1 is appended by the client.
# Copy to .env.local; replace with the backend domain for deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# mock: Next 개발 서버의 명세 기반 HTTP mock / live: 실제 백엔드.
NEXT_PUBLIC_AUTH_MODE=mock

# google: 실제 Google 인증 / mock: 개발 중 Google 창 없이 분기 테스트.
NEXT_PUBLIC_GOOGLE_AUTH_MODE=google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=465200297393-5pnl5hpbmf4g9nbfn2a9jk44lu952ut5.apps.googleusercontent.com

# HTTP mock 전용. false: 신규 회원, true: 기존 회원. 변경 후 서버 재시작.
MOCK_GOOGLE_REGISTERED=false
